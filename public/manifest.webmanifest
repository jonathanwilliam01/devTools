{
  "name": "devTools",
  "short_name": "devTools",
  "description": "Notas, histórico de cards, tarefas e ferramentas de dev.",
  "id": "/",
  "start_url": "/inicio",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f7f9",
  "theme_color": "#2f6fde",
  "lang": "pt-BR",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Tarefas", "url": "/tarefas" },
    { "name": "Notas", "url": "/notas" },
    { "name": "Ferramentas", "url": "/ferramentas" }
  ],
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "arquivo", "accept": ["image/*", "text/*", ".csv", ".tsv", ".txt", ".log", ".sql", ".json", ".xml"] }]
    }
  },
  "file_handlers": [
    {
      "action": "/ferramentas",
      "accept": {
        "text/plain": [".txt", ".log", ".sql"],
        "text/csv": [".csv", ".tsv"],
        "application/json": [".json"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
